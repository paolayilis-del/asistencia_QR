{
  "name": "asistencia-qr-2026",
  "version": "3.7.0",
  "private": true,
  "description": "Sistema Web de Asistencia Docente por QR",
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/iniciar.ps1",
    "stop": "powershell -ExecutionPolicy Bypass -File scripts/detener.ps1",
    "estilos": "npx --yes tailwindcss@3 -c tailwind.config.js -i aplicacion/estaticos/css/fuente.css -o aplicacion/estaticos/css/estilos.css --minify",
    "estilos:watch": "npx --yes tailwindcss@3 -c tailwind.config.js -i aplicacion/estaticos/css/fuente.css -o aplicacion/estaticos/css/estilos.css --watch"
  }
}
